  "views": [
    {
      "name": "course_seats",
      "definition": " SELECT o.id AS \"openCourseId\",\n    o.\"courseCode\",\n    o.\"sectionNo\",\n    o.capacity,\n    (count(e.id))::integer AS \"enrolledCount\",\n    (GREATEST((0)::bigint, (o.capacity - count(e.id))))::integer AS \"remainingSeats\"\n   FROM (open_courses o\n     LEFT JOIN enrollments e ON (((e.\"openCourseId\" = o.id) AND (e.status = 'enrolled'::text))))\n  GROUP BY o.id;"
    }
  ],
